# Clé API Resend (resend.com) — nécessaire pour l'envoi du formulaire de contact.
RESEND_API_KEY=

# Optionnel : adresse d'expédition une fois un domaine vérifié sur Resend.
# Tant qu'aucun domaine n'est vérifié, garder la valeur par défaut ci-dessous
# (ou ne pas définir la variable) pour utiliser le domaine de test de Resend.
# RESEND_FROM="Djaté POS <contact@djatepos.app>"
